{
  "name": "yuvo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:deploy": "pnpm run demo:build && WRANGLER_LOG_PATH=.wrangler/demo-deploy.log wrangler deploy --config wrangler.demo.jsonc",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:worker": "WRANGLER_LOG_PATH=.wrangler/logs/worker-tests.log vitest run --config vitest.config.ts",
    "test:local-db": "vitest run --config vitest.local.config.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config wrangler.example.jsonc",
    "cf:types:check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config wrangler.example.jsonc --check",
    "cf:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "cf:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "cf:deploy": "pnpm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "assets:splash": "node scripts/generate-splash.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mmmike/web-push": "0.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.121.0"
  },
  "type": "module"
}
